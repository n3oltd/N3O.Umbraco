<Project>
    <!-- Repo-wide defaults. Applies to every project under the repo root. -->
    <PropertyGroup>
        <DefaultItemExcludes>$(DefaultItemExcludes);**\node_modules\**;**\dist\**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- Frontend (backoffice client app) projects opt in by having a `frontend/` directory. They are
         Razor SDK RCLs that serve their built wwwroot/App_Plugins assets at the site root via static
         web assets; their TypeScript source under frontend/ must not be treated as project items. -->
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\frontend')">
        <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
        <DefaultItemExcludes>$(DefaultItemExcludes);frontend\**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- Surface the frontend/ source in the IDE as display-only None items (None defaults to no copy,
         no pack), so the folder is browsable from the project even though it's excluded from the SDK's
         default compile/content globs above. The npm/Turbo build owns these files; MSBuild ignores them. -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\frontend')">
        <None Include="frontend\**" Exclude="frontend\**\dist\**;frontend\**\.turbo\**" />
    </ItemGroup>

    <!-- The "react-plugin" opt-in (<N3OReactPlugin>true</N3OReactPlugin> → auto-reference the shared
         N3O.Umbraco.ReactRuntime) is wired in Directory.Build.targets, not here: a project sets the
         property in its own body, which is evaluated AFTER this .props is imported, so the import must
         live in the .targets (imported after the body) for the condition to see the value. -->
</Project>
