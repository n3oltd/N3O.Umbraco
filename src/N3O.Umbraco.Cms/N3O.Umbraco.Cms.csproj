<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RootNamespace>N3O.Umbraco.Cms</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Copyright>Copyright © 2026 N3O Ltd</Copyright>
        <NoWarn>NU1605;1591</NoWarn>
        <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <!-- StaticWebAssetBasePath, node_modules/dist/frontend excludes come from the repo-root
             Directory.Build.props (frontend-project convention). The frontend MSBuild seam now runs a single
             workspace-wide Turbo build (no per-project filter) and Cms copies only its own DynamicListViews
             dist; @n3oltd/backoffice-core (auth-fetch + the workspace-visibility condition) ships from the
             referenced N3O.Umbraco.ReactRuntime. -->
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>N3O.Umbraco.Cms</PackageId>
        <IsPackable>true</IsPackable>
        <ContentTargetFolders>.</ContentTargetFolders>
        <Authors>N3O Ltd</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>TODO</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://n3o.ltd</PackageProjectUrl>
        <RepositoryUrl>https://github.com/n3oltd/umbraco-extensions</RepositoryUrl>
        <Version>17.0.0</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugType>full</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>pdbonly</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\N3O.Umbraco.Extensions\N3O.Umbraco.Extensions.csproj" />
        <!-- Cms's Lit DynamicListViews uses backoffice-core's auth-fetch and the N3O.Condition.WorkspaceVisibility
             condition, both shipped by ReactRuntime (the @n3oltd/backoffice-core import map + condition manifest).
             Referencing it guarantees they are installed alongside Cms. -->
        <ProjectReference Include="..\N3O.Umbraco.ReactRuntime\N3O.Umbraco.ReactRuntime.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Diplo.GodMode" Version="17.0.0" />
        <PackageReference Include="Umbraco.Community.Contentment" Version="6.1.4" />
        <PackageReference Include="Umbraco.Cms" Version="17.3.5" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.8" />
    </ItemGroup>
    <ItemGroup>
        <None Update="README.md">
            <Pack>True</Pack>
        </None>
    </ItemGroup>
</Project>
