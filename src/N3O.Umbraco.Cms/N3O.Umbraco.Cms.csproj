<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RootNamespace>N3O.Umbraco.Cms</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Copyright>Copyright © 2026 N3O Ltd</Copyright>
        <NoWarn>NU1605;1591</NoWarn>
        <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <!-- StaticWebAssetBasePath, node_modules/dist/frontend excludes come from the repo-root
             Directory.Build.props (frontend-project convention). N3OFrontendFilter scopes the Turbo
             build to Cms's own apps: DynamicListViews + the shared N3O.Umbraco.BackofficeCore. -->
        <N3OFrontendFilter>--filter=@n3oltd/dynamic-list-views --filter=@n3oltd/backoffice-core</N3OFrontendFilter>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>N3O.Umbraco.Cms</PackageId>
        <IsPackable>true</IsPackable>
        <ContentTargetFolders>.</ContentTargetFolders>
        <Authors>N3O Ltd</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>TODO</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://n3o.ltd</PackageProjectUrl>
        <RepositoryUrl>https://github.com/n3oltd/umbraco-extensions</RepositoryUrl>
        <Version>17.0.0</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugType>full</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>pdbonly</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\N3O.Umbraco.Extensions\N3O.Umbraco.Extensions.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Diplo.GodMode" Version="17.0.0" />
        <PackageReference Include="Umbraco.Community.Contentment" Version="6.1.4" />
        <PackageReference Include="Umbraco.Cms" Version="17.3.5" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.8" />
    </ItemGroup>
    <ItemGroup>
        <None Update="README.md">
            <Pack>True</Pack>
        </None>
    </ItemGroup>
    <ItemGroup>
        <!-- The shared, non-React N3O.Umbraco.BackofficeCore (src/frontend/backoffice-core — auth-fetch +
             the workspace-visibility condition) is shipped by Cms because every site references Cms, so
             the condition/import-map is always present. Its dist lives outside this project, so add it to
             the frontend copy explicitly; DynamicListViews (frontend/*) is picked up by convention. -->
        <N3OFrontendExtraDist Include="$(MSBuildProjectDirectory)\..\frontend\backoffice-core\dist\**\*" />
    </ItemGroup>
</Project>
