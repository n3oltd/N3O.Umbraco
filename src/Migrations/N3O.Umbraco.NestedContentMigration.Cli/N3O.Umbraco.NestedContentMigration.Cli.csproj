<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>N3O.Umbraco.NestedContentMigration.Cli</RootNamespace>
        <AssemblyName>nc-migrate</AssemblyName>
        <LangVersion>12</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <!-- Must be false: Microsoft.Data.SqlClient throws "Globalization Invariant Mode is not supported"
             on SqlConnection.Open() under invariant mode, so the tool can't connect to any database. -->
        <InvariantGlobalization>false</InvariantGlobalization>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
</Project>
