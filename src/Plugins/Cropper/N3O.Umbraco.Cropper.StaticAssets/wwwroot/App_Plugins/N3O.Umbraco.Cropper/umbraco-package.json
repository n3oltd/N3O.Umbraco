{
    "$schema": "http://json.schemastore.org/umbraco-package.json",
    "id": "N3O.Umbraco.Cropper",
    "name": "N3O Cropper",
    "version": "17.0.0",
    "extensions": [
        {
            "type": "propertyEditorSchema",
            "alias": "N3O.Umbraco.Cropper",
            "name": "N3O Cropper",
            "meta": {
                "defaultPropertyEditorUiAlias": "N3O.Umbraco.Cropper",
                "settings": {
                    "properties": [
                        {
                            "alias": "altText",
                            "label": "Alt Text",
                            "description": "Allow editors to enter alt text for the image.",
                            "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle"
                        },
                        {
                            "alias": "cropDefinitions",
                            "label": "Crop Definitions",
                            "propertyEditorUiAlias": "N3O.PropertyEditorUi.CropperCropDefinitions"
                        }
                    ]
                }
            }
        },
        {
            "type": "propertyEditorUi",
            "alias": "N3O.Umbraco.Cropper",
            "name": "N3O Cropper",
            "element": "/App_Plugins/N3O.Umbraco.Cropper/cropper.js",
            "meta": {
                "label": "N3O Cropper",
                "icon": "icon-crop",
                "group": "media",
                "propertyEditorSchemaAlias": "N3O.Umbraco.Cropper"
            }
        },
        {
            "type": "propertyEditorUi",
            "alias": "N3O.PropertyEditorUi.CropperCropDefinitions",
            "name": "N3O Cropper Crop Definitions",
            "element": "/App_Plugins/N3O.Umbraco.Cropper/crop-definitions.js",
            "meta": {
                "label": "N3O Cropper Crop Definitions",
                "icon": "icon-crop",
                "group": "media"
            }
        }
    ]
}
