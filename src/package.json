{
  "name": "@n3oltd/client-root",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build --env-mode=loose"
  },
  "workspaces": [
