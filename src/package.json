    "react-dom": "19.2.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "turbo": "^2.5.0",
    "syncpack": "^13.0.0"
  },
  "overrides": {
    "@umbraco-cms/backoffice": "17.3.5",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
