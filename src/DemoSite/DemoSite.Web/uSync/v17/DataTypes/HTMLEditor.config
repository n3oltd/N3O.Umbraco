<DataType Key="de5e64ad-1c96-4620-96f2-ca071fe7a5de" Alias="HTML Editor" Level="2">
  <Info>
    <Name>HTML Editor</Name>
    <EditorAlias>Umbraco.RichText</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.Tiptap</EditorUIAlias>
    <Folder>Other</Folder>
  </Info>
  <Config><![CDATA[{
